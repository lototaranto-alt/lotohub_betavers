{
  "expo": {
    "name": "L.O.T.O. Map",
    "slug": "loto-app-fresh",
    "scheme": "lotoappfresh",
    "version": "1.0.7",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#101518",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#101518"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lotohub.app",
      "buildNumber": "9",
      "infoPlist": {
        "NFCReaderUsageDescription": "L.O.T.O. Map usa il lettore NFC per scansionare i tag fisici (Zero-IoT) e sbloccare i check-in nelle mete convenzionate.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "L.O.T.O. Map usa la posizione in background per attivare il geofencing delle mete e i check-in automatici anche a schermo spento.",
        "NSMotionUsageDescription": "L.O.T.O. Map usa il contapassi per calcolare i km percorsi in mobilità dolce e le emissioni di CO2 risparmiate nella gamification ecologica.",
        "UIBackgroundModes": [
          "fetch",
          "location"
        ]
      }
    },
    "android": {
      "package": "com.lotohub.app",
      "versionCode": 9,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#101518"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.NFC",
        "android.permission.CAMERA",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#101518",
          "image": "./assets/images/splash.png",
          "imageWidth": 320
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0"
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Consenti a L.O.T.O. Map di usare la tua posizione per aggiornare il Geofencing anche in tasca.",
          "isAndroidBackgroundLocationEnabled": true,
          "locationWhenInUsePermission": "L'App usa il GPS per ottimizzare l'esperienza in mappa, permetterti di fare i check-in e mostrarti i POI vicini."
        }
      ],
      "react-native-nfc-manager",
      "expo-font",
      "expo-web-browser",
      "expo-localization",
      [
        "expo-camera",
        {
          "cameraPermission": "L.O.T.O. Map ha bisogno della fotocamera per scansionare il tuo L.O.T.O. Pass (QR Code) e recuperare il tuo account anonimo."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "L.O.T.O. Map ha bisogno di accedere alla tua galleria per permetterti di caricare il L.O.T.O. Pass (QR Code) che avevi salvato in precedenza."
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": [
            "peripheral",
            "central"
          ],
          "bluetoothAlwaysPermission": "L.O.T.O. Map utilizza il Bluetooth per comunicare con i beacon interni (Musei/B&B) permettendoti check-in automatici e accessibilita indoor anche senza GPS."
        }
      ],
      "./withNotifee.js"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "51c54ab9-735a-43a2-9563-5247f7aaa902"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/51c54ab9-735a-43a2-9563-5247f7aaa902"
    }
  }
}
