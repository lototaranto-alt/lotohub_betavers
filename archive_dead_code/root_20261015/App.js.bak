  barrierAlertText: { color: '#FF8C00', fontSize: 12, fontWeight: 'bold', marginLeft: 8 },

  // Aggiunte "Iniezione Rapida"
  modalBg: {flex: 1, backgroundColor: 'rgba(0,0,0,0.5)', justifyContent: 'center', padding: 20},
