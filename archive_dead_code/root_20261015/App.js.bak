  wizardOptionActive: { borderColor: '#0056D2', backgroundColor: '#EBF4FF' },
  wizardOptionBlue: { borderColor: '#0056D2', backgroundColor: '#EBF4FF' },
  wizardOptionIcon: { fontSize: 30, marginRight: 15 },
  wizardOptionLabel: { fontSize: 18, fontWeight: 'bold', color: '#4A5D23' },
  wizardOptionLabelBlue: { fontSize: 18, fontWeight: 'bold', color: '#0056D2' },
  partyBtn: { width: 60, height: 60, backgroundColor: '#4A5D23', borderRadius: 30, justifyContent: 'center', alignItems: 'center' },
  partyBtnText: { color: '#FFF', fontSize: 30, fontWeight: 'bold' },
  partyValue: { fontSize: 40, fontWeight: 'bold', marginHorizontal: 30, color: '#1A202C' },

  // Aggiunte UX Inclusiva
  inclusiveBanner: { backgroundColor: 'rgba(241, 245, 249, 0.95)', padding: 12, borderBottomWidth: 1, borderBottomColor: '#E2E8F0' },
