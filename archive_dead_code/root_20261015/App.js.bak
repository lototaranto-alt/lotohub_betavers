  heroInput: {borderWidth: 2, borderColor: '#E2E8F0', borderRadius: 12, padding: 15, fontSize: 18, marginBottom: 20},
  row: { flexDirection: 'row', alignItems: 'center', marginTop: 5 },
  rankBadge: { backgroundColor: '#FFD700', paddingHorizontal: 6, paddingVertical: 2, borderRadius: 5, marginLeft: 8 },
  rankText: { fontSize: 8, fontWeight: 'bold', color: '#000' },
  rightHeader: { alignItems: 'flex-end' },
  langRow: { flexDirection: 'row', marginBottom: 10 },
  flag: { fontSize: 18, marginLeft: 10, opacity: 0.8 },
  cityImpactTicker: { backgroundColor: '#1A202C', paddingVertical: 6, marginTop: -15, marginBottom: 20, marginHorizontal: 20, borderRadius: 0, borderBottomLeftRadius: 15, borderBottomRightRadius: 15 },
  tickerText: { color: '#10B981', fontSize: 9, fontWeight: 'bold', textAlign: 'center', letterSpacing: 0.5 },
  
  // New Identity Styles
  statusBadge: { paddingHorizontal: 10, paddingVertical: 4, borderRadius: 8, marginRight: 6, marginBottom: 4 },
